---
layout: layouts/base.liquid
---
{%- assign ui_art = article_ui[lang] -%}
{%- assign url_absolue = site.url | append: page.url -%}
<style>
/* Article */
.article-body { font-size: 16px; line-height: 1.85; color: var(--text); font-weight: 300; }
.article-body p { margin-bottom: 1.25rem; }
.article-body h2 { font-size: 20px; font-weight: 600; color: var(--bg); margin: 2rem 0 1rem; }
.article-body blockquote { border-left: 4px solid var(--orange); padding: 0 0 0 24px; margin: 2rem 0; font-style: italic; font-size: 17px; color: var(--text); }
.article-img { width: 100%; border-radius: 12px; object-fit: cover; height: 420px; margin-bottom: 2rem; display: block; }
.article-badge { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; padding: 3px 10px; border-radius: 20px; display: inline-block; margin-bottom: 16px; }
.badge-portrait { background: #faeeda; color: #854f0b; }
.badge-bourse { background: #e6f1fb; color: #185fa5; }
.badge-evenement { background: #faece7; color: #993c1d; }
.badge-rapport { background: #eaf3de; color: #3b6d11; }
.share-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 500; text-decoration: none; border: 1px solid var(--bd); color: var(--text); }
.share-btn:hover { border-color: var(--orange); color: var(--orange); }
</style>
{% include "partials/header.liquid" %}

<div class="fr-bc">
  <div class="container">
    <a href="{{ 'index' | page_url: lang }}">{{ ui[lang].home }}</a><span class="sep">/</span>
    <a href="{{ 'actualites' | page_url: lang }}">{{ ui_art.fil_ariane }}</a><span class="sep">/</span>
    {%- assign titre_long = titre | size %}
    <span class="cur">{% if titre_long > 50 %}{{ titre | slice: 0, 50 }}...{% else %}{{ titre }}{% endif %}</span>
  </div>
</div>

<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-8 offset-lg-2">

      <!-- Badge + meta -->
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
        <span class="article-badge {{ badge.classe }}" style="margin:0;vertical-align:middle;display:inline-flex;align-items:center">{{ badge.libelle }}</span>
        <span style="font-size:13px;color:var(--muted);line-height:1;display:inline-flex;align-items:center" data-editable="text" data-type="span" data-prop="date_affichee">{{ date_affichee }}</span>
      </div>

      <!-- Titre -->
      <h1 class="heading-lg mb-4" style="font-size:28px;line-height:1.3" data-editable="text" data-type="span" data-prop="titre">{{ titre }}</h1>

      <!-- Image -->
      <img class="article-img" src="{{ image }}" alt="{{ image_alt }}" data-editable="image" data-prop-src="image" data-prop-alt="image_alt">

      <!-- Corps -->
      <div class="article-body" data-editable="text" data-type="block" data-prop="@content">{{ content }}</div>

      <!-- Partage -->
      <div style="border-top:1px solid var(--bd);padding-top:24px;margin-top:32px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span style="font-size:13px;color:var(--muted)" data-editable="text" data-type="span" data-prop="@data[article_ui].{{ lang }}.partager">{{ ui_art.partager }}</span>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ url_absolue | url_encode }}" class="share-btn" target="_blank" rel="noopener" data-share="linkedin"><i class="fab fa-linkedin-in"></i> LinkedIn</a>
        <a href="mailto:?subject={{ titre | url_encode | replace: '+', '%20' }}&amp;body={{ url_absolue | url_encode }}" class="share-btn" data-share="email"><i class="fas fa-envelope"></i> Email</a>
        <a href="{{ 'actualites' | page_url: lang }}" class="share-btn" style="margin-left:auto"><i class="fas fa-arrow-left"></i> <editable-text data-type="span" data-prop="@data[article_ui].{{ lang }}.retour">{{ ui_art.retour }}</editable-text></a>
      </div>

    </div>
  </div>
</div>

{% include "partials/footer.liquid" %}
{% include "partials/scripts.liquid" %}
{%- if site.url == blank %}
<script>
// Adresse publique du site non définie (SITE_URL) : liens de partage construits avec l'adresse courante.
(function () {
  var u = encodeURIComponent(window.location.href);
  var li = document.querySelector('[data-share="linkedin"]');
  var em = document.querySelector('[data-share="email"]');
  if (li) li.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + u;
  if (em) em.href = 'mailto:?subject=' + encodeURIComponent({{ titre | json }}) + '&body=' + u;
})();
</script>
{%- endif %}
