---
layout: layouts/base.liquid
section: ""
header_logo_height: 36
---
<style>
/* ══ ALIGNEMENT CARTES PROGRAMMES ══ */
.fr-prog { height: 100%; display: flex; flex-direction: column; }
.fr-prog-body { display: flex; flex-direction: column; flex: 1; }
.fr-prog-body p { flex: 1; }

/* ══ HEADER DROPDOWN v2 ══ */
.fr-nav ul li { position: relative; }

.fr-nav ul li > a {
  display: flex;
  align-items: center;
  gap: 5px;
  height: 68px;
}
.fr-nav ul li > a .chevron {
  font-size: 9px;
  opacity: 0.6;
  transition: transform .2s;
}
.fr-nav ul li:hover > a .chevron {
  transform: rotate(180deg);
}

/* Dropdown */
.fr-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  background: var(--bg-d);
  border: 1px solid var(--bd);
  border-top: 2px solid var(--orange);
  border-radius: 0 0 8px 8px;
  min-width: 260px;
  padding: 8px 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-6px);
  transition: opacity .2s, transform .2s, visibility .2s;
  box-shadow: 0 12px 32px rgba(0,0,0,.35);
  z-index: 300;
}
.fr-nav ul li:hover .fr-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.fr-dropdown a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 20px;
  color: var(--w70);
  font-size: 13px;
  font-weight: 400;
  text-decoration: none;
  transition: color .15s, background .15s, padding-left .15s;
  white-space: nowrap;
}
.fr-dropdown a:hover {
  color: var(--white);
  background: var(--w08);
  padding-left: 26px;
}
.fr-dropdown a i {
  font-size: 11px;
  color: var(--orange);
  width: 14px;
  text-align: center;
  flex-shrink: 0;
}
.fr-drop-sep {
  height: 1px;
  background: var(--bd);
  margin: 6px 20px;
}

/* Burger mobile */
.fr-burger {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  flex-direction: column;
  gap: 5px;
}
.fr-burger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--w70);
  border-radius: 2px;
  transition: all .3s;
}

@media(max-width:991px) {
  .fr-burger { display: flex; }
  .fr-nav {
    position: fixed;
    top: 68px; left: 0; right: 0; bottom: 0;
    background: var(--bg-d);
    padding: 24px 20px;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform .3s ease;
    z-index: 190;
  }
  .fr-nav.open { transform: translateX(0); }
  .fr-nav ul { flex-direction: column; align-items: stretch; gap: 0; }
  .fr-nav ul li > a { height: auto; padding: 12px 4px; border-radius: 0; border-bottom: 1px solid var(--bd); justify-content: space-between; }
  .fr-nav ul li.cta { margin-top: 16px; }
  .fr-nav ul li.cta > a { justify-content: center; border-radius: 4px; border-bottom: none; padding: 12px 18px; }
  .fr-dropdown { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: none; border-radius: 0; background: transparent; padding: 0 0 0 16px; display: none; }
  .fr-nav ul li.drop-open .fr-dropdown { display: block; }
  .fr-dropdown a { padding: 9px 4px; border-bottom: 1px solid rgba(255,255,255,.05); font-size: 12px; }
  .fr-dropdown a:hover { padding-left: 10px; }
}

/* ══ HERO OVERRIDE — plein écran avec image ══ */
.fr-hero-home {
  background: var(--bg-d);
  position: relative;
  overflow: hidden;
  min-height: 520px;
  display: flex;
  align-items: center;
}
.fr-hero-home::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, rgba(7,22,46,.97) 0%, rgba(12,34,81,.88) 45%, rgba(12,34,81,.3) 100%);
  z-index: 1;
}
.fr-hero-home-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
}
.fr-hero-home .container {
  position: relative;
  z-index: 2;
  padding-top: 72px;
  padding-bottom: 80px;
}
.fr-ribbon {
  height: 4px;
  background: linear-gradient(90deg, var(--orange) 0%, rgba(212,107,43,.15) 100%);
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
}


/* ══ CARROUSEL TÉMOIGNAGES ══ */
.fr-carousel { position: relative; }
.fr-temo-slide { display: none; align-items: flex-start; gap: 40px; animation: temoFade 0.4s ease; }
.fr-temo-slide.temo-active { display: flex; }
@keyframes temoFade { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
.fr-temo-photo { width:110px; height:110px; border-radius:50%; flex-shrink:0; object-fit:cover; object-position:top center; border:2px solid rgba(212,107,43,0.4); margin-top:4px; }
.fr-temo-body { flex:1; }
.fr-temo-quote { font-size:17px; font-style:italic; color:rgba(255,255,255,0.88); line-height:1.75; margin-bottom:20px; font-weight:300; padding-left:20px; position:relative; }
.fr-temo-quote::before { content:''; position:absolute; left:0; top:4px; bottom:4px; width:3px; background:#D46B2B; border-radius:2px; opacity:0.6; }
.fr-temo-name { font-size:15px; font-weight:600; color:#fff; margin-bottom:3px; }
.fr-temo-school { font-size:12px; color:#D46B2B; font-weight:500; margin-bottom:2px; }
.fr-temo-origin { font-size:11px; color:rgba(255,255,255,0.35); letter-spacing:0.5px; }
.fr-temo-controls { display:flex; align-items:center; gap:14px; margin-top:36px; }
.fr-temo-btn { width:38px; height:38px; border-radius:50%; border:1.5px solid rgba(255,255,255,0.18); background:transparent; color:rgba(255,255,255,0.55); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s; font-size:15px; }
.fr-temo-btn:hover { border-color:#D46B2B; color:#D46B2B; }
.fr-temo-dots { display:flex; gap:7px; align-items:center; }
.fr-temo-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.2); cursor:pointer; transition:all 0.25s; }
.fr-temo-dot.active { background:#D46B2B; width:22px; border-radius:3px; }
.fr-temo-counter { margin-left:auto; font-size:11px; color:rgba(255,255,255,0.3); letter-spacing:1px; }
@media (max-width: 576px) {
  .fr-temo-slide.temo-active { flex-direction:column; align-items:center; text-align:center; }
  .fr-temo-quote::before { display:none; }
  .fr-temo-quote { padding-left:0; }
}

/* ══ PROFILS — plus discret ══ */
.fr-profils {
  background: var(--bg-d);
  padding: 14px 48px 18px;
  border-bottom: 1px solid var(--bd);
}
.fr-profils-label {
  font-size: 10px;
  letter-spacing: 2.5px;
  color: var(--w45);
  text-transform: uppercase;
  margin-bottom: 10px;
  font-weight: 500;
}

/* ══ PARTENAIRES ══ */
.fr-partners-section {
  background: #fff;
  padding: 56px 0;
  border-top: 1px solid var(--bl);
}
.fr-partners-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 32px 48px;
  margin-top: 32px;
}

/* ══ STICKY BAR ══ */
.fr-sticky {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 150;
  background: var(--bg-mid);
  border-top: 1px solid var(--bd);
  padding: 11px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}
.fr-sticky-left {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--w70);
  font-weight: 300;
}
.fr-sticky-left i {
  color: var(--orange);
  font-size: 11px;
}
.fr-sticky-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

@media(max-width:768px) {
  .fr-sticky { padding: 10px 20px; flex-wrap: wrap; justify-content: center; }
  .fr-sticky-left { display: none; }
  .fr-profils { padding: 14px 20px 18px; }
}
</style>
{% include "partials/header.liquid" %}

<main>

<!-- ══ HERO ══ -->
<section class="fr-hero-home">
  <img src="{{ hero.image }}" alt="{{ hero.image_alt }}" class="fr-hero-home-img" data-editable="image" data-prop-src="hero.image" data-prop-alt="hero.image_alt">
  <div class="container">
    <div class="row">
      <div class="col-12 col-lg-7">
        <div class="fr-hero-tag"><i class="fas fa-star"></i> <editable-text data-type="span" data-prop="hero.etiquette">{{ hero.etiquette }}</editable-text></div>
        <h1 class="heading-xl mb-3"><editable-text data-type="span" data-prop="hero.titre.ligne_1">{{ hero.titre.ligne_1 }}</editable-text><br>{% include "partials/hl.liquid", t: hero.titre, prop: "hero.titre", tag: "strong" %}</h1>
        <p style="font-size:15px;font-weight:300;color:rgba(255,255,255,.7);line-height:1.75;max-width:500px;margin-bottom:32px" data-editable="text" data-type="text" data-prop="hero.texte">{{ hero.texte }}</p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="{{ hero.bouton_principal.page | page_url: lang }}" class="btn-orange"><i class="fas {{ hero.bouton_principal.icone }}"></i> <editable-text data-type="span" data-prop="hero.bouton_principal.texte">{{ hero.bouton_principal.texte }}</editable-text></a>
          <a href="{{ hero.bouton_secondaire.page | page_url: lang }}" class="btn-outline-w"><i class="fas {{ hero.bouton_secondaire.icone }}"></i> <editable-text data-type="span" data-prop="hero.bouton_secondaire.texte">{{ hero.bouton_secondaire.texte }}</editable-text></a>
        </div>
      </div>
    </div>
  </div>
  <div class="fr-ribbon"></div>
</section>

<!-- ══ PROFILS ══ -->
<div class="fr-profils">
  <div class="container">
    <p class="fr-profils-label" data-editable="text" data-type="span" data-prop="profils.titre">{{ profils.titre }}</p>
    <div data-editable="array" data-prop="profils.boutons">
{%- for b in profils.boutons %}
      <a href="{{ b.page | page_url: lang }}" class="fr-profil-btn" data-editable="array-item"><i class="fas {{ b.icone }}"></i> <editable-text data-type="span" data-prop="texte">{{ b.texte }}</editable-text></a>
{%- endfor %}
    </div>
  </div>
</div>

<!-- ══ CHIFFRES CLÉS ══ -->
<section class="container py-5">
  <div class="row mb-4">
    <div class="col-12 col-lg-6">
      <p class="fr-label" data-editable="text" data-type="span" data-prop="chiffres.surtitre">{{ chiffres.surtitre }}</p>
      <h2 class="heading-lg mb-2">{% include "partials/hl.liquid", t: chiffres.titre, prop: "chiffres.titre", tag: "span" %}</h2>
      <p class="fr-sub" data-editable="text" data-type="text" data-prop="chiffres.texte">{{ chiffres.texte }}</p>
    </div>
  </div>
  <div class="row g-3" data-editable="array" data-prop="chiffres.elements">
{%- for s in chiffres.elements %}
    <div class="col-6 col-md-3" data-editable="array-item"><div class="fr-stat"><span class="fr-stat-num" data-editable="text" data-type="span" data-prop="nombre">{{ s.nombre }}</span><div class="fr-stat-label" data-editable="text" data-type="span" data-prop="libelle">{{ s.libelle }}</div></div></div>
{%- endfor %}
  </div>
</section>

<!-- ══ PROGRAMMES ══ -->
<section class="container py-4 mb-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="fr-label" data-editable="text" data-type="span" data-prop="programmes.surtitre">{{ programmes.surtitre }}</p>
      <h2 class="heading-lg">{% include "partials/hl.liquid", t: programmes.titre, prop: "programmes.titre", tag: "span" %}</h2>
    </div>
    <a href="{{ programmes.lien.page | page_url: lang }}" class="fr-link d-none d-md-flex" style="white-space:nowrap"><editable-text data-type="span" data-prop="programmes.lien.texte">{{ programmes.lien.texte }}</editable-text> <i class="fas fa-arrow-right"></i></a>
  </div>
  <div class="row g-3" data-editable="array" data-prop="programmes.cartes">
{%- for c in programmes.cartes %}
    <div class="col-12 col-md-6 col-lg-3" data-editable="array-item">
      <a href="{{ c.page | page_url: lang }}" class="fr-prog">
        <div class="fr-prog-header"><img src="{{ c.image }}" alt="{{ c.image_alt }}" loading="lazy" decoding="async" data-editable="image" data-prop-src="image" data-prop-alt="image_alt"><span class="fr-prog-badge" data-editable="text" data-type="span" data-prop="badge">{{ c.badge }}</span></div>
        <div class="fr-prog-body"><h3 data-editable="text" data-type="span" data-prop="titre">{{ c.titre }}</h3><p data-editable="text" data-type="text" data-prop="texte">{{ c.texte }}</p><span class="fr-link"><editable-text data-type="span" data-prop="lien_texte">{{ c.lien_texte }}</editable-text> <i class="fas fa-arrow-right"></i></span></div>
      </a>
    </div>
{%- endfor %}
  </div>
</section>

<!-- ══ TÉMOIGNAGES ══ -->
<section class="bg-dark-section" id="temoignages">
  <div class="container">
    <p class="fr-label inv" data-editable="text" data-type="span" data-prop="temoignages_section.surtitre">{{ temoignages_section.surtitre }}</p>
    <h2 class="heading-lg on-dark mb-5">{% include "partials/hl.liquid", t: temoignages_section.titre, prop: "temoignages_section.titre", tag: "span" %}</h2>
    <div class="fr-carousel">
      <div data-editable="array" data-prop="temoignages" style="display:contents">
{%- for t in temoignages %}
      <div class="fr-temo-slide{% if forloop.first %} temo-active{% endif %}" data-editable="array-item">
        <img class="fr-temo-photo" src="{{ t.photo }}" alt="{{ t.nom }}" decoding="async" data-editable="image" data-prop-src="photo">
        <div class="fr-temo-body">
          <p class="fr-temo-quote" data-editable="text" data-type="text" data-prop="citation">{{ t.citation }}</p>
          <div class="fr-temo-name" data-editable="text" data-type="span" data-prop="nom">{{ t.nom }}</div>
          <div class="fr-temo-school" data-editable="text" data-type="span" data-prop="ecole">{{ t.ecole }}</div>
          <div class="fr-temo-origin" data-editable="text" data-type="span" data-prop="origine">{{ t.origine }}</div>
        </div>
      </div>
{%- endfor %}
      </div>
      <div class="fr-temo-controls">
        <button class="fr-temo-btn" id="tprev" aria-label="{{ temoignages_section.precedent }}">&#8592;</button>
        <button class="fr-temo-btn" id="tnext" aria-label="{{ temoignages_section.suivant }}">&#8594;</button>
        <div class="fr-temo-dots" id="tdots"></div>
        <span class="fr-temo-counter" id="tcounter">1 / {{ temoignages | size }}</span>
      </div>
    </div>
    <div class="text-center mt-4"><a href="{{ temoignages_section.bouton.page | page_url: lang }}" class="btn-white" data-editable="text" data-type="span" data-prop="temoignages_section.bouton.texte">{{ temoignages_section.bouton.texte }}</a></div>
  </div>
</section>

<!-- ══ PARTENAIRES ══ -->
<section class="fr-partners-section">
  <div class="container">
    <div class="row mb-2">
      <div class="col-12 col-lg-7">
        <p class="fr-label" data-editable="text" data-type="span" data-prop="partenaires.surtitre">{{ partenaires.surtitre }}</p>
        <h2 class="heading-lg mb-2">{% include "partials/hl.liquid", t: partenaires.titre, prop: "partenaires.titre", tag: "span" %}</h2>
        <p class="fr-sub" data-editable="text" data-type="text" data-prop="partenaires.texte">{{ partenaires.texte }}</p>
      </div>
    </div>
    <div class="fr-partners-grid" data-editable="array" data-prop="@data[logos_partenaires].logos">
{%- for l in logos_partenaires.logos %}
      <a href="{{ l.url }}" target="_blank" class="fr-partner" data-editable="array-item"><img src="{{ l.logo }}" alt="{{ l.alt }}" style="max-height:44px;max-width:130px" loading="lazy" decoding="async" onerror="this.outerHTML='<span style=font-size:12px;font-weight:600;color:#555>{{ l.nom }}</span>'" data-editable="image" data-prop-src="logo" data-prop-alt="alt"></a>
{%- endfor %}
    </div>
    <div class="text-center mt-4">
      <a href="{{ partenaires.lien.page | page_url: lang }}" class="fr-link" style="justify-content:center;font-size:13px"><editable-text data-type="span" data-prop="partenaires.lien.texte">{{ partenaires.lien.texte }}</editable-text> <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ══ ACTUALITÉS ══ -->
{%- comment -%} Cartes générées depuis les fiches actualités (a_la_une: true, triées par ordre_une) : pas de zone éditable ici. {%- endcomment -%}
{%- if lang == "en" %}{% assign src = collections.actualites_en %}{% else %}{% assign src = collections.actualites_fr %}{% endif %}
{%- assign une = src | where_value: "a_la_une", true | sort: "data.ordre_une" %}
{%- assign grande = une | first %}
<section class="container py-4 mb-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="fr-label" data-editable="text" data-type="span" data-prop="actualites.surtitre">{{ actualites.surtitre }}</p><h2 class="heading-lg">{% include "partials/hl.liquid", t: actualites.titre, prop: "actualites.titre", tag: "span" %}</h2></div>
    <a href="{{ actualites.lien.page | page_url: lang }}" class="fr-link d-none d-md-flex" style="white-space:nowrap"><editable-text data-type="span" data-prop="actualites.lien.texte">{{ actualites.lien.texte }}</editable-text> <i class="fas fa-arrow-right"></i></a>
  </div>
  <div class="row g-3">
    <div class="col-12 col-lg-6">
{%- if grande %}
      <a href="{{ 'actualites' | page_url: lang }}{{ grande.data.article_id }}/" class="fr-cover" style="height:300px">
        <img src="{{ grande.data.image }}" alt="{{ grande.data.image_alt }}" style="height:300px" loading="lazy" decoding="async">
        <div class="fr-cover-overlay">
          <div class="fr-cover-date"><span class="day">{{ grande.data.date_jour }}</span><span class="month">{{ grande.data.date_mois }}</span></div>
          <div class="fr-cover-divider"></div>
          <div class="fr-cover-title">{{ grande.data.titre_une | default: grande.data.titre }}</div>
        </div>
      </a>
{%- endif %}
    </div>
    <div class="col-12 col-lg-6 d-flex flex-column">
{%- for a in une offset: 1 limit: 3 %}
      <a href="{{ 'actualites' | page_url: lang }}{{ a.data.article_id }}/" class="fr-card d-flex gap-3 align-items-center" style="padding:14px">
        <img src="{{ a.data.image }}" alt="" style="width:90px;height:70px;object-fit:cover;border-radius:6px;flex-shrink:0" loading="lazy" decoding="async">
        <div><span style="font-size:10px;color:var(--orange);font-weight:600;letter-spacing:.5px">{{ a.data.badge.libelle | upcase }}</span><h5 style="font-size:13px;font-weight:600;margin:4px 0 2px;line-height:1.3">{{ a.data.titre_une | default: a.data.titre }}</h5><span style="font-size:11px;color:var(--muted)">{{ a.data.date_liste }}</span></div>
      </a>
{%- endfor %}
    </div>
  </div>
</section>

</main>

<!-- ══ STICKY BAR ══ -->
<div class="fr-sticky">
  <div class="fr-sticky-left">
    <i class="fas fa-circle" style="font-size:7px"></i>
    <span data-editable="text" data-type="span" data-prop="barre.texte">{{ barre.texte }}</span>
  </div>
  <div class="fr-sticky-right">
    <a href="{{ barre.bouton_principal.page | page_url: lang }}" class="btn-orange" style="font-size:12px;padding:7px 18px"><i class="fas {{ barre.bouton_principal.icone }} me-2"></i><editable-text data-type="span" data-prop="barre.bouton_principal.texte">{{ barre.bouton_principal.texte }}</editable-text></a>
    <a href="{{ barre.bouton_secondaire.page | page_url: lang }}" class="btn-outline-w" style="font-size:12px;padding:7px 18px" data-editable="text" data-type="span" data-prop="barre.bouton_secondaire.texte">{{ barre.bouton_secondaire.texte }}</a>
  </div>
</div>

{% include "partials/footer.liquid" %}
{% include "partials/scripts.liquid" %}

<script>
(function(){
  var slides = document.querySelectorAll('.fr-temo-slide');
  var dotsEl = document.getElementById('tdots');
  var counter = document.getElementById('tcounter');
  if (!slides.length) return;
  var current = 0;
  slides.forEach(function(_, i) {
    var d = document.createElement('div');
    d.className = 'fr-temo-dot' + (i===0?' active':'');
    d.addEventListener('click', function(){ goTo(i); });
    dotsEl.appendChild(d);
  });
  function goTo(n) {
    slides[current].classList.remove('temo-active');
    document.querySelectorAll('.fr-temo-dot')[current].classList.remove('active');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('temo-active');
    document.querySelectorAll('.fr-temo-dot')[current].classList.add('active');
    counter.textContent = (current+1) + ' / ' + slides.length;
  }
  document.getElementById('tprev').addEventListener('click', function(){ goTo(current-1); });
  document.getElementById('tnext').addEventListener('click', function(){ goTo(current+1); });
})();
</script>
