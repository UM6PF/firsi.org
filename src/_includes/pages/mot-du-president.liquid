---
layout: layouts/base.liquid
section: fondation
---
{% include "partials/header.liquid" %}
{% include "partials/breadcrumb.liquid" %}
<section class="fr-hero">
  <div class="container">
    <div class="fr-hero-tag"><i class="fas fa-user-tie"></i> <editable-text data-type="span" data-prop="hero.etiquette">{{ hero.etiquette }}</editable-text></div>
    <h1 class="heading-xl mb-3">{% include "partials/hl.liquid", t: hero.titre, prop: "hero.titre", tag: "strong" %}</h1>
    <div class="fr-ribbon"></div>
  </div>
</section>
<div class="container py-5">
  <div class="row g-5">
    <div class="col-12 col-lg-3 text-center">
      <div style="width:200px;height:260px;border-radius:12px;overflow:hidden;margin:0 auto 20px;border:3px solid var(--orange)">
        <img src="{{ president.image }}" alt="{{ president.image_alt }}" style="width:100%;height:100%;object-fit:cover;object-position:top" data-editable="image" data-prop-src="president.image" data-prop-alt="president.image_alt">
      </div>
      <h4 style="font-weight:700;color:var(--bg);margin-bottom:4px;font-size:16px" data-editable="text" data-type="span" data-prop="president.nom">{{ president.nom }}</h4>
      <p style="font-size:12px;color:var(--orange);font-weight:600;margin-bottom:4px" data-editable="text" data-type="span" data-prop="president.fonction">{{ president.fonction }}</p>
      <p style="font-size:12px;color:var(--muted);line-height:1.5"><editable-text data-type="span" data-prop="president.organisation_ligne1">{{ president.organisation_ligne1 }}</editable-text><br><editable-text data-type="span" data-prop="president.organisation_ligne2">{{ president.organisation_ligne2 }}</editable-text></p>
    </div>
    <div class="col-12 col-lg-9">
      <blockquote style="border-left:4px solid var(--orange);padding:0 0 0 24px;margin-bottom:28px">
        <p style="font-size:1.05rem;font-style:italic;color:var(--text);line-height:1.8;font-weight:300" data-editable="text" data-type="span" data-prop="message.citation">{{ message.citation }}</p>
      </blockquote>
      <h2 class="heading-lg mb-4">{% include "partials/hl.liquid", t: message.titre, prop: "message.titre", tag: "span" %}</h2>
      <div data-editable="array" data-prop="message.paragraphes" style="display:contents">
{%- for p in message.paragraphes %}
      <p style="font-size:15px;color:var(--muted);line-height:1.8;font-weight:300{% unless forloop.last %};margin-bottom:18px{% endunless %}" data-editable="array-item"><editable-text data-type="span" data-prop="texte">{{ p.texte }}</editable-text></p>
{%- endfor %}
      </div>
    </div>
  </div>
</div>

{% include "partials/footer.liquid" %}
{% include "partials/scripts.liquid" %}
