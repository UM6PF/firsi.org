---
layout: layouts/base.liquid
section: fondation
---
{% include "partials/header.liquid" %}
{% include "partials/breadcrumb.liquid" %}
<section class="fr-hero">
  <div class="container">
    <div class="fr-hero-tag"><i class="fas fa-handshake"></i> <editable-text data-type="span" data-prop="hero.etiquette">{{ hero.etiquette }}</editable-text></div>
    <h1 class="heading-xl mb-3">{% include "partials/hl.liquid", t: hero.titre, prop: "hero.titre", tag: "strong" %}</h1>
    <p style="font-size:15px;font-weight:300;color:rgba(255,255,255,.7);max-width:560px;line-height:1.75" data-editable="text" data-type="text" data-prop="hero.texte">{{ hero.texte }}</p>
    <div class="fr-ribbon"></div>
  </div>
</section>
<div class="container py-5">
  <div data-editable="array" data-prop="groupes" style="display:contents">
{%- for groupe in groupes %}
{%- assign gi = forloop.index0 %}
  <div class="mb-5" data-editable="array-item">
    <p class="fr-label" data-editable="text" data-type="span" data-prop="surtitre">{{ groupe.surtitre }}</p>
    <h2 class="heading-lg mb-4">{% include "partials/hl.liquid", t: groupe.titre, prop: "titre", tag: "span" %}</h2>
    <div class="row g-4" data-editable="array" data-prop="etablissements">
{%- for e in groupe.etablissements %}
      <div class="col-6 col-md-4 col-lg-3 text-center" data-editable="array-item">
        <div class="fr-card" style="align-items:center;display:flex;flex-direction:column">
          <img src="{{ e.logo }}" alt="{{ e.logo_alt }}" style="max-height:60px;max-width:140px;object-fit:contain;margin-bottom:12px"{% if gi > 0 or forloop.index > 4 %} loading="lazy" decoding="async"{% endif %} onerror="this.style.display='none'" data-editable="image" data-prop-src="logo" data-prop-alt="logo_alt">
          <h5 style="font-size:13px;font-weight:600;color:var(--text)" data-editable="text" data-type="span" data-prop="nom">{{ e.nom }}</h5>
          <p style="font-size:12px;color:var(--muted)" data-editable="text" data-type="span" data-prop="lieu">{{ e.lieu }}</p>
        </div>
      </div>
{%- endfor %}
    </div>
  </div>
{%- endfor %}
  </div>
  <div class="row">
    <div class="col-12">
      <div style="background:var(--bg);border-radius:12px;padding:32px;text-align:center">
        <h3 style="color:var(--white);font-weight:300;margin-bottom:12px">{% include "partials/hl.liquid", t: cta.titre, prop: "cta.titre", tag: "strong", style: "color:var(--orange)" %}</h3>
        <p style="color:rgba(255,255,255,.7);font-size:14px;font-weight:300;margin-bottom:24px;max-width:480px;margin-left:auto;margin-right:auto" data-editable="text" data-type="text" data-prop="cta.texte">{{ cta.texte }}</p>
        <a href="{{ cta.page | page_url: lang }}" class="btn-orange" data-editable="text" data-type="span" data-prop="cta.bouton">{{ cta.bouton }}</a>
      </div>
    </div>
  </div>
</div>

{% include "partials/footer.liquid" %}
{% include "partials/scripts.liquid" %}
