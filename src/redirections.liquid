---
# Anciennes adresses du prototype (mission.html, mission-en.html…) : redirigent vers les nouvelles adresses.
# index.html n'a pas besoin de redirection (c'est la page d'accueil elle-même).
pagination:
  data: redirections
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="{{ r.lang }}">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex">
<title>FIRSI</title>
<link rel="canonical" href="{{ r.to }}">
<meta http-equiv="refresh" content="0; url={{ r.to }}">
<script>location.replace("{{ r.to }}" + location.hash);</script>
</head>
<body>
<p><a href="{{ r.to }}">{{ r.to }}</a></p>
</body>
</html>
